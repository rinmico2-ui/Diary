# Copy to .env and adjust. Never commit real secrets.

NODE_ENV=development
PORT=4000

# Public origin of the web client (used for CORS + cookie handling)
WEB_ORIGIN=http://localhost:5173

# Signs the stored session-token digests (HMAC-SHA256). Must be 32+ characters.
# Without it, a leaked database dump could be replayed as valid cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=dev-only-change-me-please-generate-a-real-secret-key

# Directory for persistent data (database + uploads). On Render, point this at
# your mounted disk path, e.g. /var/data. Auto-detected when /var/data or /data
# exists.
# DATA_DIR=/var/data

# Absolute or relative path to the SQLite database file (used when DATABASE_URL is empty)
DATABASE_PATH=./data/our-space.db

# Optional: remote libSQL/Turso database URL for deployments where the local
# disk is ephemeral. When set, the app reads and writes this database instead
# of (or in sync with) the local file, so data survives redeploys.
# Example: libsql://your-db-your-org.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Optional: keep a local replica that syncs with a remote database.
# Set DATABASE_SYNC_URL to the remote URL and DATABASE_PATH to the local file.
DATABASE_SYNC_URL=

# Directory where uploaded originals, thumbnails and voice notes are written
STORAGE_DIR=./data/storage

# Upload limits
MAX_UPLOAD_BYTES=15728640
MAX_AUDIO_UPLOAD_BYTES=10485760
MAX_FILES_PER_UPLOAD=20

# Shared secret required to create an account. The space only ever holds two people.
# Generate with: node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
INVITE_CODE=change-this-invite-code

# Name shown across the app
SPACE_NAME=Our Little Space ❤️

# Set to 1 when serving over HTTPS so cookies get the Secure flag
COOKIE_SECURE=0

# Comma separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=600
UPLOAD_RATE_LIMIT_MAX=120

# Set to 1 to print every account (email + name) in the boot log. Useful on
# hosts where you cannot open a shell, e.g. a free tier with no console.
LOG_ACCOUNTS=0

# Outbound SMTP — required for "Forgot password" emails.
# Leaving SMTP_HOST empty disables sending; the reset endpoint then replies
# with a clear "not configured" error instead of pretending a mail was sent.
# Examples: smtp-relay.brevo.com (587), smtp.gmail.com (587),
#           smtp.resend.com (465, SMTP_SECURE=1)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Our Little Space <no-reply@example.com>
